{
  "name": "student-nep-credit-tracker",
  "version": "1.0.0",
  "description": "Student NEP Credit Tracker - MERN Stack Web Application",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "test:api": "node server/testApi.js"
  },
  "dependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "nep-2020",
    "credit-tracker",
    "mern",
    "msc-computer-science",
    "mongodb",
    "express",
    "react",
    "node"
  ],
  "author": "M.Sc. Computer Science",
  "license": "MIT"
}
